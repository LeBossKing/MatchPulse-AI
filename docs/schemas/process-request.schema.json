{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audience": {
      "default": "analyst",
      "enum": [
        "fan",
        "analyst"
      ],
      "title": "Audience",
      "type": "string"
    },
    "event_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
      "title": "Event Id",
      "type": "string"
    },
    "language": {
      "default": "en",
      "enum": [
        "en",
        "fr"
      ],
      "title": "Language",
      "type": "string"
    },
    "match_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
      "title": "Match Id",
      "type": "string"
    }
  },
  "required": [
    "match_id",
    "event_id"
  ],
  "title": "ProcessEventRequest",
  "type": "object"
}
