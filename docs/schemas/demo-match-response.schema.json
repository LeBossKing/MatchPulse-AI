{
  "$defs": {
    "MatchMetadata": {
      "additionalProperties": false,
      "properties": {
        "away_team": {
          "$ref": "#/$defs/Team"
        },
        "coordinate_origin": {
          "const": "top_left",
          "default": "top_left",
          "title": "Coordinate Origin",
          "type": "string"
        },
        "coordinate_system": {
          "const": "normalized_0_100",
          "default": "normalized_0_100",
          "title": "Coordinate System",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "home_team": {
          "$ref": "#/$defs/Team"
        },
        "match_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "title": "Match Id",
          "type": "string"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/Player"
          },
          "minItems": 2,
          "title": "Players",
          "type": "array"
        },
        "score": {
          "$ref": "#/$defs/Score"
        }
      },
      "required": [
        "match_id",
        "home_team",
        "away_team",
        "players",
        "score",
        "coordinate_system",
        "coordinate_origin",
        "description"
      ],
      "title": "MatchMetadata",
      "type": "object"
    },
    "MatchStatistics": {
      "additionalProperties": false,
      "properties": {
        "event_count": {
          "default": 0,
          "minimum": 0,
          "title": "Event Count",
          "type": "integer"
        },
        "scope": {
          "const": "demo_sequence",
          "default": "demo_sequence",
          "title": "Scope",
          "type": "string"
        },
        "teams": {
          "items": {
            "$ref": "#/$defs/TeamStatistics"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Teams",
          "type": "array"
        },
        "through_event_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Through Event Id"
        }
      },
      "required": [
        "scope",
        "event_count",
        "through_event_id",
        "teams"
      ],
      "title": "MatchStatistics",
      "type": "object"
    },
    "Player": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "player_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "title": "Player Id",
          "type": "string"
        },
        "team_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "title": "Team Id",
          "type": "string"
        }
      },
      "required": [
        "player_id",
        "team_id",
        "name"
      ],
      "title": "Player",
      "type": "object"
    },
    "Score": {
      "additionalProperties": false,
      "properties": {
        "away": {
          "minimum": 0,
          "title": "Away",
          "type": "integer"
        },
        "home": {
          "minimum": 0,
          "title": "Home",
          "type": "integer"
        }
      },
      "required": [
        "home",
        "away"
      ],
      "title": "Score",
      "type": "object"
    },
    "Team": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "team_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "title": "Team Id",
          "type": "string"
        }
      },
      "required": [
        "team_id",
        "name"
      ],
      "title": "Team",
      "type": "object"
    },
    "TeamStatistics": {
      "additionalProperties": false,
      "properties": {
        "interceptions": {
          "default": 0,
          "minimum": 0,
          "title": "Interceptions",
          "type": "integer"
        },
        "pass_accuracy_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass Accuracy Pct"
        },
        "passes_attempted": {
          "default": 0,
          "minimum": 0,
          "title": "Passes Attempted",
          "type": "integer"
        },
        "passes_completed": {
          "default": 0,
          "minimum": 0,
          "title": "Passes Completed",
          "type": "integer"
        },
        "recoveries": {
          "default": 0,
          "minimum": 0,
          "title": "Recoveries",
          "type": "integer"
        },
        "team_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "title": "Team Id",
          "type": "string"
        }
      },
      "required": [
        "team_id",
        "passes_attempted",
        "passes_completed",
        "pass_accuracy_pct",
        "interceptions",
        "recoveries"
      ],
      "title": "TeamStatistics",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotation_note": {
      "title": "Annotation Note",
      "type": "string"
    },
    "data_source": {
      "const": "synthetic",
      "default": "synthetic",
      "title": "Data Source",
      "type": "string"
    },
    "match": {
      "$ref": "#/$defs/MatchMetadata"
    },
    "review_status": {
      "enum": [
        "pending_review",
        "approved"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "statistics": {
      "$ref": "#/$defs/MatchStatistics"
    }
  },
  "required": [
    "schema_version",
    "data_source",
    "review_status",
    "annotation_note",
    "match",
    "statistics"
  ],
  "title": "DemoMatchResponse",
  "type": "object"
}
