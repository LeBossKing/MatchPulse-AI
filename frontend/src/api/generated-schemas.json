          "period": {
            "maximum": 2,
            "minimum": 1,
            "title": "Period",
            "type": "integer"
          },
          "player_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "title": "Player Id",
            "type": "string"
          },
          "pressure": {
            "anyOf": [
              {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Pressure"
          },
          "second": {
            "maximum": 59,
            "minimum": 0,
            "title": "Second",
            "type": "integer"
          },
          "start": {
            "$ref": "#/$defs/Point"
          },
          "successful": {
            "title": "Successful",
            "type": "boolean"
          },
          "target_player_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target Player Id"
          },
          "team_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "title": "Team Id",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "match_id",
          "period",
          "minute",
          "second",
          "event_type",
          "team_id",
          "player_id",
          "target_player_id",
          "attacking_direction",
          "start",
          "end",
          "successful",
          "pressure",
          "lines_broken"
