APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
LLM_PROVIDER=mock

# Backend only. Use the resource endpoint and the DEPLOYMENT name from Foundry.
# Keep LLM_PROVIDER=mock until the live preflight passes, then set it to azure.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_TIMEOUT_SECONDS=15
AZURE_OPENAI_MAX_OUTPUT_TOKENS=2048
